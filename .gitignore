# Mac OS Finder
.DS_Store

# JetBrains IDEs https://www.jetbrains.com/help/idea/gitignore.html
*.iml
.idea/
misc.xml
modules.xml

# Gradle https://docs.gradle.org/current/userguide/directory_layout.html
.gradle/
build/

# Built application files
*.apk
*.aab
*.ap_

# Files for the Dalvik VM
*.dex

# Java class files
*.class

# Log files
*.log

# Android Studio Navigation editor files
.navigation/

# Android Studio captures folder
captures/

# Annotation Processors cache file
*/build/generated/ap_generated_sources/*

# Generated files
*/build/generated/*

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by build
proguard/

# Windows thumbnail cache files
Thumbs.db

# Keystore files (IMPORTANT: Never commit keystore files!)
*.jks
*.keystore

# Google Services file
google-services.json

# Secrets (e.g., API keys) - Ensure this is properly handled and not committed
secrets.properties

# Lint results
lint-results-*.xml

# History files (some IDEs)
.history

# VS Code settings
.vscode/

# Kover report directory (Code coverage)
kover/

# Benchmark results
benchmark/baseline-prof.txt
benchmark/startup-prof.txt